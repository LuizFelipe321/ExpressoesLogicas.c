#include <stdio.h>
/*Escreva um programa que leia (do usuário) dois números e mostre o maior deles. Se, por acaso,
os dois números forem iguais, imprima a mensagem “Números iguais”.*/

int main()
{
    int num1, num2;
    printf("Digite o primeiro e o segundo numero:\n");
    scanf("%d %d", &num1, &num2);

    if (num1 == num2){
        printf("Os numeros sao iguais\n");
    if (num1 > num2)
        printf("Numero Um eh maior\n");
    if (num2 > num1)
        printf("Numero Dois eh maior\n");
    }
    else{
        printf("Valor invalido\n");
    }

    printf("Numeros digitados pelo usuario foram num1: %d \n num2: %d", num1, num2);


    return 0;
}
